# Copy to backend/.env for local development. On Render, set these under
# the service's Environment tab instead. Never commit the real .env file.

PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/lung_cancer_risk

# Required when NODE_ENV=production: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origins allowed to call the API (comma-separated, no trailing slash).
# Localhost is also allowed automatically when NODE_ENV is not production.
CLIENT_URLS=http://localhost:5173

# FastAPI ML service (no trailing slash), e.g. https://pulmodetect-ml.onrender.com
ML_SERVICE_URL=http://localhost:8000
# How long to wait for the ML service, in ms. Free hosts can take ~60 s to wake up.
ML_TIMEOUT_MS=75000

# Optional: chatbot. Without a key the chatbot uses built-in answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
